# Copy this file to ".env" and fill in your real Supabase project values.
# Find these in the Supabase Dashboard under Project Settings -> API.

# Project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon"/"publishable" key - safe to expose, used for regular auth calls
SUPABASE_ANON_KEY=your-anon-public-key

# Secret "service_role" key - NEVER expose this to the client, server-only.
# Used to manage the profiles table (bypasses Row Level Security).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional - defaults to 3000 if not set
PORT=3000
